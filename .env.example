# ===========================================================================
# Copy this file to `.env` in the project root and fill in your own values.
# `.env` is git-ignored. Never commit real keys, and never put them in the
# frontend — only the backend reads this file.
# ===========================================================================

# --- Required -------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- LangSmith observability ----------------------------------------------
# Traces LangChain runs, including inputs, outputs, latency and errors.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=conversational-ai-rag-chatbot

# --- Optional: Hugging Face ----------------------------------------------
# Only needed for gated/private embedding models. all-MiniLM-L6-v2 is public,
# so you can leave this blank.
HF_TOKEN=

# --- Models ---------------------------------------------------------------
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chat behaviour -------------------------------------------------------
DEFAULT_LANGUAGE=English
# Token budget for the trimmed history sent to the model on each turn.
MAX_HISTORY_TOKENS=3000

# --- Retrieval (RAG) ------------------------------------------------------
# Set to false to run the chat without the vector store (skips loading torch).
RAG_ENABLED=true
RAG_TOP_K=3
# CHROMA_DIR=backend/data/chroma
# KNOWLEDGE_BASE_DIR=backend/knowledge_base

# --- Storage --------------------------------------------------------------
# SQLite by default. For PostgreSQL, install psycopg and use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chatdb
# DATABASE_URL=sqlite:///./backend/data/conversations.db

# --- Server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
